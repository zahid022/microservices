
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Float
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}